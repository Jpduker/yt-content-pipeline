Dialogue: 0,0:00:00.00,0:00:34.46,Label,,0,0,0,,UNOFFICIAL GTA VI FAN FICTION
Dialogue: 1,0:00:00.00,0:00:03.44,Hook,,0,0,0,,HER PHOTO.\NIN THEIR STOLEN CAR.
Dialogue: 2,0:00:00.08,0:00:01.35,Caption,,0,0,0,,LUCIA FOUND HER OWN
Dialogue: 2,0:00:01.36,0:00:02.50,Caption,,0,0,0,,PHOTO IN THEIR STOLEN
Dialogue: 2,0:00:02.60,0:00:03.38,Caption,,0,0,0,,CAR.
Dialogue: 2,0:00:03.44,0:00:05.14,Caption,,0,0,0,,TAKEN OUTSIDE THEIR MOTEL…
Dialogue: 2,0:00:05.16,0:00:06.50,Caption,,0,0,0,,TEN MINUTES AGO.
Dialogue: 2,0:00:06.52,0:00:07.90,Caption,,0,0,0,,THEN THEIR FIXER CALLED.
Dialogue: 2,0:00:08.07,0:00:08.67,Caption,,0,0,0,,"BRING THE CAR TO
Dialogue: 2,0:00:08.68,0:00:09.67,Caption,,0,0,0,,THE DOCKS.
Dialogue: 2,0:00:09.68,0:00:10.71,Caption,,0,0,0,,COME ALONE."
Dialogue: 2,0:00:10.72,0:00:12.10,Caption,,0,0,0,,UNDER THE SEAT: HIS
Dialogue: 2,0:00:12.16,0:00:13.11,Caption,,0,0,0,,CASH BAG…
Dialogue: 2,0:00:13.12,0:00:13.46,Caption,,0,0,0,,AND A
Dialogue: 2,0:00:13.60,0:00:14.42,Caption,,0,0,0,,TRACKER.
Dialogue: 2,0:00:14.44,0:00:15.95,Caption,,0,0,0,,THEY WERE THE DELIVERY.
Dialogue: 2,0:00:15.96,0:00:16.95,Caption,,0,0,0,,SO LUCIA SENT THE
Dialogue: 2,0:00:16.96,0:00:17.95,Caption,,0,0,0,,CAR AHEAD, ON A
Dialogue: 2,0:00:17.96,0:00:18.99,Caption,,0,0,0,,TOW TRUCK.
Dialogue: 2,0:00:19.00,0:00:19.99,Caption,,0,0,0,,AT THE DOCKS, THE
Dialogue: 2,0:00:20.00,0:00:21.59,Caption,,0,0,0,,FIXER PULLED A GUN.
Dialogue: 2,0:00:21.60,0:00:22.90,Caption,,0,0,0,,THE POLICE WERE ALREADY
Dialogue: 2,0:00:23.00,0:00:23.86,Caption,,0,0,0,,CLOSING IN.
Dialogue: 2,0:00:23.92,0:00:25.46,Caption,,0,0,0,,LUCIA HAD CALLED THEM.
Dialogue: 2,0:00:25.56,0:00:26.95,Caption,,0,0,0,,ACROSS THE WATER, JASON
Dialogue: 2,0:00:26.96,0:00:27.46,Caption,,0,0,0,,WATCHED THE
Dialogue: 2,0:00:27.60,0:00:28.14,Caption,,0,0,0,,LIGHTS.
Dialogue: 2,0:00:28.24,0:00:29.99,Caption,,0,0,0,,"THERE GOES OUR PAYDAY."
Dialogue: 2,0:00:30.00,0:00:31.19,Caption,,0,0,0,,LUCIA OPENED THE BAG
Dialogue: 2,0:00:31.20,0:00:31.99,Caption,,0,0,0,,SHE'D TAKEN FROM THE
Dialogue: 2,0:00:32.00,0:00:32.83,Caption,,0,0,0,,CAR.
Dialogue: 2,0:00:32.84,0:00:34.10,Caption,,0,0,0,,"YOUR PAYDAY."
