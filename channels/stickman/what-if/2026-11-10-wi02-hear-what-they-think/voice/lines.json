[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You wake up able to hear what people think of you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "hook"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "By tonight, your best friend will think\u2014",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "hook"
 },
 {
  "id": "L003",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "I miss him.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "hook"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You'll be sitting right beside her.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "hook"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "It starts in the caf\u00e9.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L006",
  "tag": "BARISTA",
  "thought": false,
  "soft": false,
  "text": "Usual?",
  "voice": "am_puck",
  "speed": 1.0,
  "sec": "act1"
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Then, without moving his lips:",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L008",
  "tag": "BARISTA",
  "thought": true,
  "soft": false,
  "text": "Please don't tell me that joke again.",
  "voice": "am_puck",
  "speed": 1.0,
  "sec": "act1"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You close your mouth.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "He looks relieved.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L011",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You've heard him.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Not everything in his head. Just thoughts about you, when he's close enough to talk.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "There is no mute button.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Your best friend Mira arrives.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L015",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "Nice hoodie.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act1"
 },
 {
  "id": "L016",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "That green makes him look like a traffic light.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act1"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You stare at her.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Then she thinks\u2014",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L019",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "Still. He looks happier.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act1"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Two thoughts. Three seconds apart.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You remember the first.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act1"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "At work, this starts feeling useful.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Your manager asks for an opinion.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L024",
  "tag": "BOSS",
  "thought": true,
  "soft": false,
  "text": "Please disagree with me. Someone needs to.",
  "voice": "bm_george",
  "speed": 1.0,
  "sec": "act2"
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "So you do.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L026",
  "tag": "BOSS",
  "thought": false,
  "soft": false,
  "text": "Exactly!",
  "voice": "bm_george",
  "speed": 1.0,
  "sec": "act2"
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Your colleague glances over.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L028",
  "tag": "COLL",
  "thought": true,
  "soft": false,
  "text": "He lets the boss finish. Why does he always interrupt me?",
  "voice": "af_nicole",
  "speed": 1.0,
  "sec": "act2"
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "That afternoon, you let her finish.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She smiles too.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "By lunch, you have discovered a shortcut to being liked.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You laugh before the punchline. Stop telling a story before anyone gets bored. Order the cheap dish because your friend is worried about splitting the bill.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "People relax around you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You keep a little list on a napkin.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Talk less. Be funnier. Be more confident. Don't make everything a joke.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "The list gets longer.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L037",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "By six, it has twenty-three rules.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "On the train, you catch someone looking at you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L039",
  "tag": "TRAIN",
  "thought": true,
  "soft": false,
  "text": "That hoodie\u2014",
  "voice": "bf_emma",
  "speed": 0.97,
  "sec": "act2"
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You straighten it.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L041",
  "tag": "TRAIN",
  "thought": true,
  "soft": false,
  "text": "\u2014my brother had one like that.",
  "voice": "bf_emma",
  "speed": 0.97,
  "sec": "act2"
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She turns back to the window.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You've already taken it off.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act2"
 },
 {
  "id": "L044",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "At six, Mira texts.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L045",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Coffee? Rough day.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L046",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You get there first. Buy her favourite. Choose the quiet table. Rehearse three things to say.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She arrives without her usual yellow jacket.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L048",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You almost ask why.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L049",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "He's going to ask about the interview.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "So you don't.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L051",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You talk about a film instead.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L052",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "Please don't make me do small talk.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L053",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You stop.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L054",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She fiddles with the cardboard sleeve on her cup.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L055",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "Say something.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L056",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You start.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L057",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "Not a joke.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You swallow the joke.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L059",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "For the next ten minutes, you choose every sentence before she can dislike it.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L060",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You agree when she criticises the film you loved. Pretend you aren't hungry when she doesn't want dinner. Start laughing, then stop halfway through.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L061",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Mira watches you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L062",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "You okay?",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L063",
  "tag": "YOU",
  "thought": false,
  "soft": false,
  "text": "Of course.",
  "voice": "am_michael",
  "speed": 0.92,
  "sec": "act3"
 },
 {
  "id": "L064",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "You're being really\u2026 careful.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L065",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Then you hear it.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L066",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "I miss him.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L067",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You look behind you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L068",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Nobody.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L069",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She means you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L070",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You're less than a metre away.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L071",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Your napkin is covered in instructions.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L072",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "For the first time today, none of them helps.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L073",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "Did something happen?",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L074",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You could invent the answer she wants.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L075",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Instead, you put the napkin between you.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L076",
  "tag": "YOU",
  "thought": false,
  "soft": false,
  "text": "I've spent all day trying not to annoy anyone.",
  "voice": "am_michael",
  "speed": 0.92,
  "sec": "act3"
 },
 {
  "id": "L077",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "She reads it.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L078",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "Even me?",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L079",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You nod.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L080",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "Her first thought is\u2014",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L081",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "That sounds exhausting.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L082",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "The next is\u2014",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L083",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "I wish he'd trusted me.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L084",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "That one hurts.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L085",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You leave it alone.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L086",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "I got rejected. From the course.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L087",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You start reaching for something reassuring.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L088",
  "tag": "MIRA",
  "thought": true,
  "soft": false,
  "text": "Please don't say everything happens for a reason.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L089",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You put your hand back on the table.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L090",
  "tag": "YOU",
  "thought": false,
  "soft": false,
  "text": "I don't know what to say.",
  "voice": "am_michael",
  "speed": 0.92,
  "sec": "act3"
 },
 {
  "id": "L091",
  "tag": "MIRA",
  "thought": false,
  "soft": false,
  "text": "Good. You can stop looking for it.",
  "voice": "af_heart",
  "speed": 1.0,
  "sec": "act3"
 },
 {
  "id": "L092",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "You sit together.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
 {
  "id": "L093",
  "tag": "N",
  "thought": false,
  "soft": false,
  "text": "The coffee machine hisses. Someone drops a spoon.",
  "voice": "am_michael",
  "speed": 0.95,
  "sec": "act3"
 },
