[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "text": "You wake up able to hear what people think of you.",
  "start": 0.6,
  "end": 3.26
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "text": "By tonight, your best friend will think\u2014",
  "start": 3.56,
  "end": 5.733
 },
 {
  "id": "L003",
  "tag": "MIRA",
  "thought": true,
  "text": "I miss him.",
  "start": 5.953,
  "end": 7.318
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "text": "You'll be sitting right beside her.",
  "start": 8.238,
  "end": 10.042
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "text": "It starts in the caf\u00e9.",
  "start": 12.642,
  "end": 14.156
 },
 {
  "id": "L006",
  "tag": "BARISTA",
  "thought": false,
  "text": "Usual?",
  "start": 14.576,
  "end": 15.208
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "text": "Then, without moving his lips:",
  "start": 15.628,
  "end": 17.426
 },
 {
  "id": "L008",
  "tag": "BARISTA",
  "thought": true,
  "text": "Please don't tell me that joke again.",
  "start": 17.846,
  "end": 20.176
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "text": "You close your mouth.",
  "start": 20.596,
  "end": 21.896
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "text": "He looks relieved.",
  "start": 22.196,
  "end": 23.37
 },
 {
  "id": "L011",
  "tag": "N",
  "thought": false,
  "text": "You've heard him.",
  "start": 23.67,
  "end": 24.721
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "text": "Not everything in his head. Just thoughts about you, when he's close enough to talk.",
  "start": 25.021,
  "end": 30.035
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "text": "There is no mute button.",
  "start": 30.335,
  "end": 31.747
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "text": "Your best friend Mira arrives.",
  "start": 32.347,
  "end": 34.276
 },
 {
  "id": "L015",
  "tag": "MIRA",
  "thought": false,
  "text": "Nice hoodie.",
  "start": 34.696,
  "end": 35.494
 },
 {
  "id": "L016",
  "tag": "MIRA",
  "thought": true,
  "text": "That green makes him look like a traffic light.",
  "start": 35.914,
  "end": 38.711
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "text": "You stare at her.",
  "start": 39.131,
  "end": 40.186
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "text": "Then she thinks\u2014",
  "start": 40.486,
  "end": 41.55
 },
 {
  "id": "L019",
  "tag": "MIRA",
  "thought": true,
  "text": "Still. He looks happier.",
  "start": 41.77,
  "end": 43.668
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "text": "Two thoughts. Three seconds apart.",
  "start": 44.088,
  "end": 46.375
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "text": "You remember the first.",
  "start": 47.075,
  "end": 48.471
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "text": "At work, this starts feeling useful.",
  "start": 49.571,
  "end": 51.744
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "text": "Your manager asks for an opinion.",
  "start": 52.044,
  "end": 54.045
 },
 {
  "id": "L024",
  "tag": "BOSS",
  "thought": true,
  "text": "Please disagree with me. Someone needs to.",
  "start": 54.465,
  "end": 57.986
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "text": "So you do.",
  "start": 58.406,
  "end": 59.413
 },
 {
  "id": "L026",
  "tag": "BOSS",
  "thought": false,
  "text": "Exactly!",
  "start": 59.833,
  "end": 60.845
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "text": "Your colleague glances over.",
  "start": 61.265,
  "end": 63.017
 },
 {
  "id": "L028",
  "tag": "COLL",
  "thought": true,
  "text": "He lets the boss finish. Why does he always interrupt me?",
  "start": 63.437,
  "end": 68.382
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "text": "That afternoon, you let her finish.",
  "start": 68.802,
  "end": 70.795
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "text": "She smiles too.",
  "start": 71.095,
  "end": 72.298
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "text": "By lunch, you have discovered a shortcut to being liked.",
  "start": 72.598,
  "end": 75.843
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "text": "You laugh before the punchline. Stop telling a story before anyone gets bored. Order the cheap dish because your friend is worried about splitting the bill.",
  "start": 76.143,
  "end": 86.188
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "text": "People relax around you.",
  "start": 86.488,
  "end": 87.986
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "text": "You keep a little list on a napkin.",
  "start": 88.286,
  "end": 90.233
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "text": "Talk less. Be funnier. Be more confident. Don't make everything a joke.",
  "start": 90.533,
  "end": 95.301
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "text": "The list gets longer.",
  "start": 95.601,
  "end": 96.991
 },
 {
  "id": "L037",
  "tag": "N",
  "thought": false,
  "text": "By six, it has twenty-three rules.",
  "start": 97.291,
  "end": 99.643
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "text": "On the train, you catch someone looking at you.",
  "start": 99.943,
  "end": 102.374
 },
 {
  "id": "L039",
  "tag": "TRAIN",
  "thought": true,
  "text": "That hoodie\u2014",
  "start": 102.794,
  "end": 104.269
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "text": "You straighten it.",
  "start": 104.489,
  "end": 105.467
 },
 {
  "id": "L041",
  "tag": "TRAIN",
  "thought": true,
  "text": "\u2014my brother had one like that.",
  "start": 105.887,
  "end": 108.294
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "text": "She turns back to the window.",
  "start": 108.714,
  "end": 110.347
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "text": "You're already wondering if you should take it off.",
  "start": 111.147,
  "end": 113.782
 },
 {
  "id": "L044",
  "tag": "N",
  "thought": false,
  "text": "At six, Mira texts.",
  "start": 114.982,
  "end": 116.49
 },
 {
  "id": "L045",
  "tag": "N",
  "thought": false,
  "text": "Coffee? Rough day.",
  "start": 116.79,
  "end": 118.012
 },
 {
  "id": "L046",
  "tag": "N",
  "thought": false,
  "text": "You get there first. Buy her favourite. Choose the quiet table. Rehearse three things to say.",
  "start": 118.312,
  "end": 123.914
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "text": "She arrives without her usual yellow jacket.",
  "start": 124.214,
  "end": 127.048
 },
 {
  "id": "L048",
  "tag": "N",
  "thought": false,
  "text": "You almost ask why.",
  "start": 127.348,
  "end": 128.758
 },
 {
  "id": "L049",
  "tag": "MIRA",
  "thought": true,
  "text": "He's going to ask about the interview.",
  "start": 129.178,
  "end": 131.598
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "text": "So you don't.",
  "start": 132.018,
  "end": 132.973
 },
 {
  "id": "L051",
  "tag": "N",
  "thought": false,
  "text": "You talk about a film instead.",
  "start": 133.273,
  "end": 134.978
 },
 {
  "id": "L052",
  "tag": "MIRA",
  "thought": true,
  "text": "Please don't make me do small talk.",
  "start": 135.398,
  "end": 137.81
 },
 {
  "id": "L053",
  "tag": "N",
  "thought": false,
  "text": "You stop.",
  "start": 138.23,
  "end": 139.112
 },
 {
  "id": "L054",
  "tag": "N",
  "thought": false,
  "text": "She fiddles with the cardboard sleeve on her cup.",
  "start": 139.412,
  "end": 142.216
 },
 {
  "id": "L055",
  "tag": "MIRA",
  "thought": true,
  "text": "Say something.",
  "start": 142.636,
  "end": 144.112
 },
 {
  "id": "L056",
  "tag": "N",
  "thought": false,
  "text": "You start.",
  "start": 144.532,
  "end": 145.436
 },
 {
  "id": "L057",
  "tag": "MIRA",
  "thought": true,
  "text": "Not a joke.",
  "start": 145.856,
  "end": 147.35
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "text": "You swallow the joke.",
  "start": 147.77,
  "end": 149.083
 },
 {
  "id": "L059",
  "tag": "N",
  "thought": false,
  "text": "For the next ten minutes, you choose every sentence before she can dislike it.",
  "start": 149.383,
  "end": 153.819
 },
 {
  "id": "L060",
  "tag": "N",
  "thought": false,
  "text": "You agree when she criticises the film you loved. Pretend you aren't hungry when she doesn't want dinner. Start laughing, then stop halfway through.",
  "start": 154.119,
  "end": 163.225
 },
 {
  "id": "L061",
  "tag": "N",
  "thought": false,
  "text": "Mira watches you.",
  "start": 163.525,
  "end": 164.723
 },
 {
  "id": "L062",
  "tag": "MIRA",
  "thought": false,
  "text": "You okay?",
  "start": 165.143,
  "end": 165.875
 },
 {
  "id": "L063",
  "tag": "YOU",
  "thought": false,
  "text": "Of course.",
  "start": 166.295,
  "end": 167.204
 },
 {
  "id": "L064",
  "tag": "MIRA",
  "thought": false,
  "text": "You're being really\u2026 careful.",
  "start": 167.624,
  "end": 169.16
 },
 {
  "id": "L065",
  "tag": "N",
  "thought": false,
  "text": "Then you hear it.",
  "start": 169.58,
  "end": 170.688
 },
 {
  "id": "L066",
  "tag": "MIRA",
  "thought": true,
  "text": "I miss him.",
  "start": 171.108,
  "end": 172.473
 },
 {
  "id": "L067",
  "tag": "N",
  "thought": false,
  "text": "You look behind you.",
  "start": 173.893,
  "end": 175.082
 },
 {
  "id": "L068",
  "tag": "N",
  "thought": false,
  "text": "Nobody.",
  "start": 175.882,
  "end": 176.696
 },
 {
  "id": "L069",
  "tag": "N",
  "thought": false,
  "text": "She means you.",
  "start": 177.696,
  "end": 178.695
 },
 {
  "id": "L070",
  "tag": "N",
  "thought": false,
  "text": "You're less than a metre away.",
  "start": 179.395,
  "end": 181.076
 },
 {
  "id": "L071",
  "tag": "N",
  "thought": false,
  "text": "Your napkin is covered in instructions.",
  "start": 181.376,
  "end": 183.698
 },
 {
  "id": "L072",
  "tag": "N",
  "thought": false,
  "text": "For the first time today, none of them helps.",
  "start": 183.998,
  "end": 186.585
 },
 {
  "id": "L073",
  "tag": "MIRA",
  "thought": false,
  "text": "Did something happen?",
  "start": 187.005,
  "end": 188.178
 },
 {
  "id": "L074",
  "tag": "N",
  "thought": false,
  "text": "You could invent the answer she wants.",
  "start": 188.598,
  "end": 190.636
 },
 {
  "id": "L075",
  "tag": "N",
  "thought": false,
  "text": "Instead, you put the napkin between you.",
  "start": 190.936,
  "end": 193.288
 },
 {
  "id": "L076",
  "tag": "YOU",
  "thought": false,
  "text": "I've spent all day trying not to annoy anyone.",
  "start": 193.708,
  "end": 196.644
 },
 {
  "id": "L077",
  "tag": "N",
  "thought": false,
  "text": "She reads it.",
  "start": 197.064,
  "end": 198.042
 },
 {
  "id": "L078",
  "tag": "MIRA",
  "thought": false,
  "text": "Even me?",
  "start": 198.462,
  "end": 199.205
 },
 {
  "id": "L079",
  "tag": "N",
  "thought": false,
  "text": "You nod.",
  "start": 199.625,
  "end": 200.406
 },
 {
  "id": "L080",
  "tag": "N",
  "thought": false,
  "text": "Her first thought is\u2014",
  "start": 200.706,
  "end": 202.019
 },
 {
  "id": "L081",
  "tag": "MIRA",
  "thought": true,
  "text": "That sounds exhausting.",
  "start": 202.239,
  "end": 204.15
 },
 {
  "id": "L082",
  "tag": "N",
  "thought": false,
  "text": "The next is\u2014",
  "start": 204.57,
  "end": 205.6
 },
 {
  "id": "L083",
  "tag": "MIRA",
  "thought": true,
  "text": "I wish he'd trusted me.",
  "start": 205.82,
  "end": 207.698
 },
 {
  "id": "L084",
  "tag": "N",
  "thought": false,
  "text": "That one hurts.",
  "start": 208.818,
  "end": 209.972
 },
 {
  "id": "L085",
  "tag": "N",
  "thought": false,
  "text": "You leave it alone.",
  "start": 210.672,
  "end": 211.885
 },
 {
  "id": "L086",
  "tag": "MIRA",
  "thought": false,
  "text": "I got rejected. From the course.",
  "start": 212.305,
  "end": 214.314
 },
 {
  "id": "L087",
  "tag": "N",
  "thought": false,
  "text": "You start reaching for something reassuring.",
  "start": 214.734,
  "end": 217.103
 },
 {
  "id": "L088",
  "tag": "MIRA",
  "thought": true,
  "text": "Please don't say everything happens for a reason.",
  "start": 217.523,
  "end": 220.527
 },
 {
  "id": "L089",
  "tag": "N",
  "thought": false,
  "text": "You put your hand back on the table.",
  "start": 220.947,
  "end": 223.066
 },
 {
  "id": "L090",
  "tag": "YOU",
  "thought": false,
  "text": "I don't know what to say.",
  "start": 223.486,
  "end": 224.835
 },
 {
  "id": "L091",
  "tag": "MIRA",
  "thought": false,
  "text": "Good. You can stop looking for it.",
  "start": 225.255,
  "end": 227.208
 },
 {
  "id": "L092",
  "tag": "N",
  "thought": false,
  "text": "You sit together.",
  "start": 228.628,
  "end": 229.771
 },
 {
  "id": "L093",
  "tag": "N",
  "thought": false,
  "text": "The coffee machine hisses. Someone drops a spoon.",
  "start": 230.671,
  "end": 233.973
 },
 {
  "id": "L094",
  "tag": "N",
  "thought": false,
  "text": "For a few seconds, Mira isn't thinking about you at all.",
  "start": 234.273,
  "end": 237.904
 },
 {
  "id": "L095",
  "tag": "N",
  "thought": false,
  "text": "Then\u2014",
  "start": 239.104,
  "end": 239.719
 },
 {
  "id": "L096",
  "tag": "MIRA",
  "thought": true,
  "text": "I'm glad he came.",
  "start": 239.939,
  "end": 241.642
 },
 {
  "id": "L097",
  "tag": "N",
  "thought": false,
  "text": "You could tell her you heard.",
  "start": 242.062,
  "end": 243.56
 },
 {
  "id": "L098",
  "tag": "N",
  "thought": false,
  "text": "You don't.",
  "start": 244.36,
  "end": 245.106
 },
 {
  "id": "L099",
  "tag": "N",
  "thought": false,
  "text": "After a while, she looks up.",
  "start": 246.106,
  "end": 247.714
 },
 {
  "id": "L100",
  "tag": "MIRA",
  "thought": false,
  "text": "I'm glad you came.",
  "start": 248.634,
  "end": 249.7
 },
 {
  "id": "L101",
  "tag": "YOU",
  "thought": false,
  "text": "Me too.",
  "start": 250.52,
  "end": 251.405
 },
 {
  "id": "L102",
  "tag": "N",
  "thought": false,
  "text": "You stay until the chairs go on the tables.",
  "start": 252.825,
  "end": 255.618
 },
 {
  "id": "L103",
  "tag": "N",
  "thought": false,
  "text": "Would you want to hear it?",
  "start": 258.218,
  "end": 259.438
 }
]