[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your little brother is crying on the sofa.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And you have fourteen words left.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, everyone gets a thousand words a day. Spoken or typed.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.5,
  "group": "G002"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Use them up, and you're silent until midnight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "This morning, you had a thousand.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G002"
 },
 {
  "id": "L006",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Morning!",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Nine hundred and ninety-nine.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then the group chat starts a war about pineapple on pizza.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G005"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Six hundred words later, you win.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At work, your boss asks for a quick update.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.3,
  "group": "G005"
 },
 {
  "id": "L011",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Quick. Just the headlines.",
  "voice": "bm_george",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It is not quick.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At the caf\u00e9, the barista asks how your weekend was.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 1.2,
  "group": "G008"
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You tell him. All of it.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L015",
  "tag": "BARISTA",
  "thought": false,
  "note": "",
  "text": "Cool. Oat milk?",
  "voice": "am_puck",
  "speed": 1.06,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By lunch, you have forty-one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.3,
  "group": "G010"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By dinner, fourteen.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And then Theo knocks on your door.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.5,
  "group": "G011"
 },
 {
  "id": "L019",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Can I tell you something? Something real?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Theo has nine hundred and ninety-three words. He saved them all day.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G013"
 },
 {
  "id": "L021",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I quit the football team. I didn't tell Mum.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L022",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Everyone thinks I'm lazy. I'm not. I just hate being bad at it.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L023",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Coach said I was the slowest one there. Everyone laughed.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L024",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "So I stopped going. Three weeks ago.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Three weeks. You didn't notice.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You were busy spending words on people you'll never meet.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Every sentence you want to say is longer than fourteen words.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L028",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you don't say any of them.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You nod. Nods are free.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.4,
  "group": "G015"
 },
 {
  "id": "L030",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You think I'm a quitter.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G016"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You shake your head. Also free.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G017"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then your phone buzzes. It's Mum.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.5,
  "group": "G018"
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Is Theo okay? she writes. He's been so quiet.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Typing counts. One reply could cost you everything you have left.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You can answer her. Or you can answer him.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You turn the phone face down.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G019"
 },
 {
  "id": "L037",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And you spend six words. Slowly.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L038",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You're not bad. You're just new.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Eight left.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L040",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "That's it?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L041",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That's enough.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Six.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You grab a pen. Pictures are free.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.3,
  "group": "G024"
 },
 {
  "id": "L044",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "A tiny football. A tiny Theo. And a giant trophy.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L045",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "That's not even a real trophy.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L046",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "But he's smiling.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He talks until his counter runs out. You listen until midnight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.4,
  "group": "G026"
 },
 {
  "id": "L048",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At twelve, your counter clicks back to a thousand.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L049",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Okay. Now tell me everything.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "What would you say with fourteen words?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G028"
 }
