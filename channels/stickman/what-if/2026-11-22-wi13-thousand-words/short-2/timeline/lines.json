[
 {
  "id": "L019",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Can I tell you something? Something real?",
  "sec": "act1",
  "start": 0.15,
  "end": 2.221
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Theo has nine hundred and ninety-three words. He saved them all day.",
  "sec": "act2",
  "start": 4.12,
  "end": 8.616
 },
 {
  "id": "L021",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I quit the football team. I didn't tell Mum.",
  "sec": "act2",
  "start": 8.876,
  "end": 11.081
 },
 {
  "id": "L022",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Everyone thinks I'm lazy. I'm not. I just hate being bad at it.",
  "sec": "act2",
  "start": 11.221,
  "end": 15.006
 },
 {
  "id": "L023",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Coach said I was the slowest one there. Everyone laughed.",
  "sec": "act2",
  "start": 15.147,
  "end": 17.687
 },
 {
  "id": "L024",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "So I stopped going. Three weeks ago.",
  "sec": "act2",
  "start": 17.933,
  "end": 19.855
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Three weeks. You didn't notice.",
  "sec": "act2",
  "start": 20.255,
  "end": 22.39
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You were busy spending words on people you'll never meet.",
  "sec": "act2",
  "start": 22.529,
  "end": 25.68
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Every sentence you want to say is longer than fourteen words.",
  "sec": "act2",
  "start": 25.863,
  "end": 29.688
 },
 {
  "id": "L028",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you don't say any of them.",
  "sec": "act2",
  "start": 29.904,
  "end": 31.554
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You nod. Nods are free.",
  "sec": "act2",
  "start": 32.095,
  "end": 34.077
 },
 {
  "id": "L030",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You think I'm a quitter.",
  "sec": "act2",
  "start": 34.336,
  "end": 35.597
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You shake your head. Also free.",
  "sec": "act2",
  "start": 35.997,
  "end": 38.173
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then your phone buzzes. It's Mum.",
  "sec": "act2",
  "start": 39.013,
  "end": 41.423
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Is Theo okay? she writes. He's been so quiet.",
  "sec": "act2",
  "start": 41.564,
  "end": 45.063
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Typing counts. One reply could cost you everything you have left.",
  "sec": "act2",
  "start": 45.255,
  "end": 49.67
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You can answer her. Or you can answer him.",
  "sec": "act2",
  "start": 49.809,
  "end": 52.235
 }
]