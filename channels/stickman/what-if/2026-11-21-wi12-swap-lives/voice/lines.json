[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You wake up in Mira's bed. Four hours from your own.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her phone. Her flat. Her alarm, which is a song you hate.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "For one day, you're living her life. And she's living yours.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Everyone else thinks this is completely normal.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The swap ends at midnight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L006",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Your brother is eating cereal out of a pan.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G002"
 },
 {
  "id": "L007",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "We don't have clean bowls.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L008",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Why do you live like this?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L009",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "What's on your calendar today?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L010",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Oh. Ten o'clock. Group presentation. Urban drainage. Slide four is yours.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L011",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "What's on slide four?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L012",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Drainage.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L013",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I don't know anything about drainage.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L014",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Nobody does. That's why it's a course. Also, I'm going to your work. What do you do all day?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L015",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Emails. Mostly emails about other emails.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G011"
 },
 {
  "id": "L016",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Oh no.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her course mates are lovely. They call you Mira, hand you a coffee and ask you about drains.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G013"
 },
 {
  "id": "L018",
  "tag": "AMA",
  "thought": false,
  "note": "",
  "text": "You ready, Mira?",
  "voice": "af_nova",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L019",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "So ready. Born ready. Drains.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Slide four is a pipe. You talk about the pipe for three minutes. You say \"flow\" eleven times.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G016"
 },
 {
  "id": "L021",
  "tag": "PROF",
  "thought": false,
  "note": "",
  "text": "Unusual. Passionate. Mostly wrong. B minus.",
  "voice": "bm_daniel",
  "speed": 1.02,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G017"
 },
 {
  "id": "L022",
  "tag": "AMA",
  "thought": false,
  "note": "",
  "text": "That's her best mark yet.",
  "voice": "af_nova",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You decide not to tell her.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L024",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Your boss asked me how my weekend was, and then he listened to the answer. Is he okay?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G020"
 },
 {
  "id": "L025",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That's new. He's been listening lately.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L026",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Also, I did all your emails. It took forty minutes.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L027",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That's three weeks of emails.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L028",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "You're welcome.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her phone never stops. Her mum. Her flatmates. A group called \"Course Panic\". People ask her things all day, and she answers every one of them.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G025"
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You get a strange feeling. You know her better than anyone. And you have never seen how tired she is.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her flatmates knock for pizza night. They're kind, and they're funny, and they don't know that she hates olives. You pick the olives off without thinking.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G026"
 },
 {
  "id": "L032",
  "tag": "AMA",
  "thought": false,
  "note": "",
  "text": "How did you know she hates olives?",
  "voice": "af_nova",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L033",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Lucky guess.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G028"
 },
 {
  "id": "L034",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Hey. Can I ask you something?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.9,
  "group": "G029"
 },
 {
  "id": "L035",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Sure.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L036",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "I needed your phone to check the train times. And I found your drafts.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G031"
 },
 {
  "id": "L037",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your drafts. Forty messages you started, to her, over two years, and never sent.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.8,
  "group": "G032"
 },
 {
  "id": "L038",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "\"I'm proud of you.\" \"I miss you being two minutes away.\" \"Your new flat is small and I love it.\"",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L039",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Why didn't you send any of these?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L040",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I didn't want to bother you. You've got a whole new life.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.6,
  "group": "G034"
 },
 {
  "id": "L041",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "You're in my whole new life. You're the person I tell things to.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Ten minutes to midnight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G036"
 },
 {
  "id": "L043",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Send them.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L044",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "All of them?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G038"
 },
 {
  "id": "L045",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "All forty. Before we swap back. I want to get them on my own phone.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G039"
 },
 {
  "id": "L046",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You hit send forty times. Her phone buzzes forty times in your hand, which is a very strange way to receive a hug.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G040"
 },
 {
  "id": "L047",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Number twelve is just the word \"sandwich\".",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G041"
 },
 {
  "id": "L048",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That was a whole day. You'd know if you'd been there.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G042"
 },
 {
  "id": "L049",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "I'm sending you one back for every single one.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G043"
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At midnight, you wake up in your own bed. Theo's snoring. There's a pan in the sink.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G044"
 },
 {
  "id": "L051",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "Read them all. Sending you forty back. Pace yourself.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G045"
 },
 {
  "id": "L052",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your phone buzzes forty times.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G046"
 },
 {
  "id": "L053",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You read every one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G047"
 },
 {
  "id": "L054",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "What would your best friend find in your drafts?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G048"
 }
]