[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Today there's a small blue teardrop over some people's heads.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It takes you until lunch to work out what it means.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "They've cried. Because of you.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The bus driver has one.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your mum has forty-one.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your best friend got hers\u2026 last night.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.5,
  "group": "G002"
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At first you think it's a trick of the light.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The man at the bakery, nothing. The woman with the dog, nothing.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The bus driver. One teardrop. And a look.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L010",
  "tag": "DRIVER",
  "thought": false,
  "note": "",
  "text": "You.",
  "voice": "bm_daniel",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L011",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Me?",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L012",
  "tag": "DRIVER",
  "thought": false,
  "note": "",
  "text": "Route nine. Six years ago. You paid in pennies. A hundred and forty of them. In the rain.",
  "voice": "bm_daniel",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L013",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That made you cry?",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L014",
  "tag": "DRIVER",
  "thought": false,
  "note": "",
  "text": "It was my first day.",
  "voice": "bm_daniel",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So that's the rule. A teardrop for everyone who's ever cried because of you. And a number, if it happened more than once.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your old landlord. Three. You know why.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "A stranger in the park. One.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 1.4,
  "group": "G010"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You have never seen her before in your life.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You decide to fix it. One apology per teardrop.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G011"
 },
 {
  "id": "L020",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm sorry about the pennies.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L021",
  "tag": "DRIVER",
  "thought": false,
  "note": "",
  "text": "Took you six years.",
  "voice": "bm_daniel",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The teardrop stays. Apologies don't delete them. They just sit next to them.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then, your mum. Forty-one.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G015"
 },
 {
  "id": "L024",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Mum. I need to say sorry.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G016"
 },
 {
  "id": "L025",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "What did you break?",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G017"
 },
 {
  "id": "L026",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Nothing! For all of it. I made you cry forty-one times.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L027",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "Forty-one? Is that all?",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L028",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "Sweetheart. Half of those were your school plays. You were a very moving tree.",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L029",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "A tree.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L030",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "And the day you left for the city.",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L031",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That one was sad crying.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L032",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "That one was proud crying. You'd know the difference if you called more.",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L033",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "Like last week. When you called for no reason.",
  "voice": "bf_emma",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You look at the number again. It doesn't say which kind.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.6,
  "group": "G024"
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It never did.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The stranger in the park. Two winters ago, you handed in a lost wallet, and never thought about it again.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act2",
  "pause": 1.4,
  "group": "G025"
 },
 {
  "id": "L037",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Which leaves one teardrop. Mira's. Last night's.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She's back for the weekend. You thought dinner went fine.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You said her new place sounded small. You said the course sounded hard. You joked that she'd forget you by Christmas.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It has to be one of those.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L041",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You buy flowers. Then you decide flowers look guilty. You leave them on a bench.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L042",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "You're doing the face again.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G028"
 },
 {
  "id": "L043",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Okay. Did I say something last night? Something wrong?",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L044",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "What? No.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L045",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You're sure? Because if I did\u2014",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G031"
 },
 {
  "id": "L046",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "Why would you think that?",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G032"
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You can't say, because there's a teardrop over your head. So you say the other true thing.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G033"
 },
 {
  "id": "L048",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Because I'd want to know. If I ever made you cry.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G034"
 },
 {
  "id": "L049",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "Okay, that's unfair. How did you know?",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.8,
  "group": "G035"
 },
 {
  "id": "L050",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "I found the card. In the box you packed. For when it's Monday and you hate it.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L051",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "I read it on my new kitchen floor, and cried like an idiot.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L052",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I forgot I wrote that.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G036"
 },
 {
  "id": "L053",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "I didn't.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L054",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "What did it even say?",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G038"
 },
 {
  "id": "L055",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "It said, you're allowed to hate it, and stay anyway.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G039"
 },
 {
  "id": "L056",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That's pretty good.",
  "voice": "am_michael",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G040"
 },
 {
  "id": "L057",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "Don't.",
  "voice": "af_heart",
  "speed": 1.08,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G041"
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The teardrop's still there. You hope it stays.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.8,
  "group": "G042"
 },
 {
  "id": "L059",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In the caf\u00e9 window, your own reflection. And over your head, small and blue,",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G043"
 },
 {
  "id": "L060",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "you know exactly whose that is.",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G044"
 },
 {
  "id": "L061",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Would you want to know?",
  "voice": "am_michael",
  "speed": 1.0,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G045"
 }
]