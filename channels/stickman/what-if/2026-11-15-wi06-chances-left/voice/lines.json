 },
 {
  "id": "L019",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "Can I borrow your charger? And your jacket. And forty quid.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G013"
 },
 {
  "id": "L020",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You already have my charger.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L021",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "Then just the forty. Also, can I stay at yours for a bit?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Three hundred and twelve. Little brothers are built for this.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G016"
 },
 {
  "id": "L023",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "You never call.",
  "voice": "bf_emma",
  "speed": 1.05,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G017"
 },
 {
  "id": "L024",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm calling now.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L025",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "Then you're forgiven. Did you eat?",
  "voice": "bf_emma",
  "speed": 1.05,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The symbol over her head doesn't even flicker.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And then there's Mira.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.6,
  "group": "G021"
 },
 {
  "id": "L028",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Four hours away, at her new course. With a one over her head.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G022"
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "One more mistake, and that's it. Whatever \"it\" is.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you get careful.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You do the maths. If every mistake costs one chance, the only safe amount of Mira is none.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her call comes at nine. You let it ring. A call is twenty minutes of things you could say wrong.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.4,
  "group": "G023"
 },
 {
  "id": "L033",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "You alive?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You write a reply. Then a shorter one. Then a thumbs up.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She sends a photo of her new flat. You don't say it's small. You don't say anything.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G026"
 },
 {
  "id": "L036",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "Why are you being weird with Mira?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.9,
  "group": "G027"
 },
 {
  "id": "L037",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm not being weird.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G028"
 },
 {
  "id": "L038",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "She texted me. Me. To ask if you're okay.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Mira never texts Theo. Theo can't even spell okay.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L040",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "Showcase on Friday. My first one. Will you come?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G031"
 },
 {
  "id": "L041",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Four hours on a train. A whole evening of chances to get it wrong.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G032"
 },
 {
  "id": "L042",
  "tag": "YOU",
  "thought": false,
  "note": "text",
  "text": "Can't. Work. I'll watch the stream?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You send it.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.5,
  "group": "G034"
 },
 {
  "id": "L044",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Somewhere four hours away, she forgives you.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 1.5,
  "group": "G035"
 },
 {
  "id": "L045",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Zero.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.5,
  "group": "G036"
 },
 {
  "id": "L046",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You spent her last chance by doing nothing at all.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "That night, you work out what you were protecting. Not her. The number.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G038"
 },
 {
  "id": "L048",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And a zero has nothing left to protect.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G039"
 },
 {
  "id": "L049",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So on Friday, you get on the train.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G040"
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Four hours. For once, you don't rehearse a single sentence.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G040"
 },
 {
  "id": "L051",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You're late. You stand at the back. You clap too loud, at the wrong moment.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G041"
 },
 {
  "id": "L052",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "That's my friend. He's weird.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G042"
 },
 {
  "id": "L053",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The audience laughs. She keeps going. She's good at this. You knew she would be.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G043"
 },
 {
  "id": "L054",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "You said you couldn't come.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 1.5,
  "group": "G044"
 },
 {
  "id": "L055",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I lied. I was scared of getting it wrong.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G045"
 },
 {
  "id": "L056",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "So you just disappeared? That's the only thing that actually hurts.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G046"
 },
 {
  "id": "L057",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know. I'm sorry.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G047"
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You wait for the number to go below zero.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.8,
  "group": "G048"
 },
 {
  "id": "L059",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "You're here now. Buy me chips, and we're even.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G049"
 },
 {
  "id": "L060",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Zero. Then, one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 1.4,
  "group": "G050"
 },
 {
  "id": "L061",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It turns out the number doesn't only go down.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G050"
 },
 {
  "id": "L062",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You buy the chips. You tell her the flat isn't small. You tell her it's very small, and very her.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G051"
 },
 {
  "id": "L063",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "Okay, now you're being weird again.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G052"
 },
 {
  "id": "L064",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You said I was weird. On a stage. In front of everyone.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G053"
 },
 {
  "id": "L065",
  "tag": "MIRA",
  "thought": false,
  "note": "",
  "text": "I said you were my friend first.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G054"
 },
 {
  "id": "L066",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Over her head, the one glows, small and gold. You stop looking at it.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G055"
 },
 {
  "id": "L067",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Would you want to know how many chances you have left?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G056"
 }
]