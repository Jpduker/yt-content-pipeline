[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your wrist has forty-one strings tied to it this morning.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And one of them just snapped.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, every promise you make becomes a string.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Keep it, and it turns gold and fades away.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Break it, and it snaps. Everybody hears it.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You promise your boss the report by Friday.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G002"
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You promise Theo you'll fix his bike.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Mira texts. She's moving flats on Sunday. You promise to help.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And Mum. You promised Mum you'd visit on Sunday. Three weeks ago.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "That one's the thickest. It hums when you walk past her photo.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L011",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Friday, the report string snaps. Your boss doesn't even look up.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Saturday, Theo's bike string snaps. He looks up for a long time.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then Sunday comes.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.3,
  "group": "G003"
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Two strings. Pulling in opposite directions.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Mum's house is east. Mira's flat is west.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Whichever way you walk, one of them breaks.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You call Mira.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G004"
 },
 {
  "id": "L018",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Let me guess. Your mum.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L019",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm sorry. I promised her first.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L020",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Then go.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And Mira does something you didn't know was possible.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She cuts her own string. Gently. So it doesn't snap.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L023",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "There. Now you didn't break anything.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L024",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You spend Sunday with Mum. Her string turns gold.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.4,
  "group": "G010"
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Monday, you knock on Mira's door with pizza.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L026",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Next Saturday. Boxes. Promise.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G011"
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She ties the new string herself.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L028",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Who holds the thickest string to you?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G012"
 }
