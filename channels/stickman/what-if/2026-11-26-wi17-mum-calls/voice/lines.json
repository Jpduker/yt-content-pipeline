[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Monday you were twenty-three. It's Friday, and you're twenty-eight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Because you ignored five of Mum's calls.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, every call from your mum that you ignore makes you one year older.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It started small. A missed call in a meeting. Twenty-four.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G002"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "A call during football. Twenty-five.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her birthday. You were busy. Three calls. Twenty-eight.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your knees click now. Your back hurts when you stand.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Your friends think you've been working too hard.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then the calls stop.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "A whole week. Not one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L011",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You should feel relieved. You're not getting any older.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "But your phone has never been this quiet.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you call her. It rings. And rings.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Voicemail.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You take the first train home.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 1.5,
  "group": "G004"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Mum is in the garden. Her phone is in the kitchen. On silent.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L017",
  "tag": "MUM",
  "thought": false,
  "note": "",
  "text": "Oh! I didn't want to bother you anymore.",
  "voice": "af_sarah",
  "speed": 1.02,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L018",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Bother me. Please. Every day.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You don't get any younger. That's not how it works.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.4,
  "group": "G007"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "But from now on, you pick up on the first ring.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "When did you last answer on the first ring?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G007"
 }
]