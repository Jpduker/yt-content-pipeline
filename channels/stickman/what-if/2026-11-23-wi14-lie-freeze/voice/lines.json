  "thought": false,
  "note": "phone",
  "text": "Hello? You froze. Did you lie to be nice?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "note": "",
