  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "One. Two. Three. Four. Five.",
