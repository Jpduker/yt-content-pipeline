[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By Friday, you can see through the barista.",
  "sec": "hook",
  "start": 1.4,
  "end": 4.255
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Not a little. You can read the menu through his chest.",
  "sec": "hook",
  "start": 4.395,
  "end": 7.871
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He's been making your coffee for two years. You've never asked his name.",
  "sec": "hook",
  "start": 8.448,
  "end": 12.506
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And he's not the only one.",
  "sec": "hook",
  "start": 13.346,
  "end": 14.901
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It starts on Monday. The man in the lift is a bit pale. You assume it's the lighting.",
  "sec": "act1",
  "start": 18.201,
  "end": 23.361
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Tuesday, Dana is talking to you while you answer an email. Halfway through her sentence, you notice you can see the printer behind her.",
  "sec": "act1",
  "start": 24.601,
  "end": 32.876
 },
 {
  "id": "L007",
  "tag": "COLL",
  "thought": false,
  "note": "",
  "text": "\u2026so that's my news. What do you think?",
  "sec": "act1",
  "start": 33.136,
  "end": 36.164
 },
 {
  "id": "L008",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Great! Yeah. Great.",
  "sec": "act1",
  "start": 36.314,
  "end": 37.729
 },
 {
  "id": "L009",
  "tag": "COLL",
  "thought": false,
  "note": "",
  "text": "I said my cat died.",
  "sec": "act1",
  "start": 37.879,
  "end": 39.268
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She fades a little more. You watch it happen.",
  "sec": "act1",
  "start": 40.268,
  "end": 42.907
 },
 {
  "id": "L011",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Dana. Sorry. I wasn't listening. Tell me about your cat.",
  "sec": "act1",
  "start": 43.167,
  "end": 46.555
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She tells you. The cat was called Biscuit, and he hated everyone except her. With every sentence, she gets a little more solid.",
  "sec": "act1",
  "start": 47.855,
  "end": 55.825
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So that's the rule. Ignore someone, and they fade. Pay attention, and they come back.",
  "sec": "act1",
  "start": 55.965,
  "end": 61.28
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Wednesday, your mum calls. You can see her kitchen tiles through her cheek.",
  "sec": "act1",
  "start": 62.52,
  "end": 67.237
 },
 {
  "id": "L015",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "I won't keep you, I know you're busy.",
  "sec": "act1",
  "start": 67.497,
  "end": 69.199
 },
 {
  "id": "L016",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm not busy. Tell me everything.",
  "sec": "act1",
  "start": 69.349,
  "end": 71.448
 },
 {
  "id": "L017",
  "tag": "MUM",
  "thought": false,
  "note": "phone",
  "text": "Everything? Well. The neighbour's cat got stuck in the bins again.",
  "sec": "act1",
  "start": 71.598,
  "end": 74.842
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She talks for forty minutes. You hear about the cat, the bins and a cousin you have never met. By the end, she's as solid as her teapot.",
  "sec": "act1",
  "start": 75.242,
  "end": 83.705
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You get good at it. You learn the barista's name: Kofi. You ask the lift man about his dog. You stop typing when your boss talks, which surprises him more than anyone.",
  "sec": "act2",
  "start": 85.605,
  "end": 96.548
 },
 {
  "id": "L020",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Are you\u2026 listening?",
  "sec": "act2",
  "start": 96.808,
  "end": 98.349
 },
 {
  "id": "L021",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Yes.",
  "sec": "act2",
  "start": 98.499,
  "end": 99.031
 },
 {
  "id": "L022",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Nobody listens. This is very unsettling.",
  "sec": "act2",
  "start": 99.181,
  "end": 102.184
 },
 {
  "id": "L023",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "What were you saying about the budget?",
  "sec": "act2",
  "start": 102.334,
  "end": 103.999
 },
 {
  "id": "L024",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "I\u2026 don't remember. Nobody's ever asked a follow-up question.",
  "sec": "act2",
  "start": 104.149,
  "end": 108.073
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By Thursday, the city looks solid again. You're exhausted. Paying attention, it turns out, is a full-time job.",
  "sec": "act2",
  "start": 108.473,
  "end": 116.023
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Friday night, you get home, drop onto the sofa, and open your phone.",
  "sec": "act2",
  "start": 117.263,
  "end": 121.752
 },
 {
  "id": "L027",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Did you see the score?",
  "sec": "act2",
  "start": 122.012,
  "end": 123.294
 },
 {
  "id": "L028",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Mm.",
  "sec": "act2",
  "start": 123.444,
  "end": 124.15
 },
 {
  "id": "L029",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I said, did you see the\u2014",
  "sec": "act2",
  "start": 124.3,
  "end": 125.668
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You look up.",
  "sec": "act2",
  "start": 127.408,
  "end": 128.195
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You can see the cushions through your brother.",
  "sec": "act2",
  "start": 129.135,
  "end": 131.385
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Not a little. Almost all the way.",
  "sec": "act2",
  "start": 131.526,
  "end": 133.79
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You checked everyone. The barista, the lift, the boss. You never checked the person on your sofa.",
  "sec": "act2",
  "start": 134.729,
  "end": 140.672
 },
 {
  "id": "L034",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Theo. What score?",
  "sec": "act3",
  "start": 141.972,
  "end": 143.339
 },
 {
  "id": "L035",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Doesn't matter.",
  "sec": "act3",
  "start": 143.489,
  "end": 144.387
 },
 {
  "id": "L036",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It does. Who played?",
  "sec": "act3",
  "start": 144.537,
  "end": 145.931
 },
 {
  "id": "L037",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You hate football.",
  "sec": "act3",
  "start": 146.081,
  "end": 147.193
 },
 {
  "id": "L038",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know. Tell me anyway.",
  "sec": "act3",
  "start": 147.343,
  "end": 148.951
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He tells you. All of it. The match, the referee, a goal he's still angry about. Then, somehow, his job interview on Monday, which you didn't know about.",
  "sec": "act3",
  "start": 150.251,
  "end": 159.733
 },
 {
  "id": "L040",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You've got an interview?",
  "sec": "act3",
  "start": 159.993,
  "end": 161.275
 },
 {
  "id": "L041",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I told you. Twice.",
  "sec": "act3",
  "start": 161.425,
  "end": 162.708
 },
 {
  "id": "L042",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Tell me a third time. I'm listening now.",
  "sec": "act3",
  "start": 162.858,
  "end": 165.316
 },
 {
  "id": "L043",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "It's at a bike shop. I like bikes. You didn't know I like bikes.",
  "sec": "act3",
  "start": 165.466,
  "end": 168.635
 },
 {
  "id": "L044",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I didn't know you like bikes.",
  "sec": "act3",
  "start": 168.785,
  "end": 170.284
 },
 {
  "id": "L045",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I've liked bikes since I was six.",
  "sec": "act3",
  "start": 170.434,
  "end": 172.186
 },
 {
  "id": "L046",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Then we'll practise. What do they ask at bike shop interviews?",
  "sec": "act3",
  "start": 172.936,
  "end": 176.398
 },
 {
  "id": "L047",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Probably about bikes.",
  "sec": "act3",
  "start": 176.548,
  "end": 177.958
 },
 {
  "id": "L048",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By midnight, he's solid again. Fully, annoyingly solid. He's eaten all your crisps.",
  "sec": "act3",
  "start": 179.258,
  "end": 184.704
 },
 {
  "id": "L049",
  "tag": "BARISTA",
  "thought": false,
  "note": "",
  "text": "Morning! The usual?",
  "sec": "act3",
  "start": 185.864,
  "end": 186.94
 },
 {
  "id": "L050",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Morning, Kofi. How's your weekend?",
  "sec": "act3",
  "start": 187.09,
  "end": 189.242
 },
 {
  "id": "L051",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Kofi looks so surprised you think he might drop the cup.",
  "sec": "act3",
  "start": 189.642,
  "end": 192.717
 },
 {
  "id": "L052",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He doesn't fade. Neither does anyone else. Not this week.",
  "sec": "act3",
  "start": 192.895,
  "end": 196.769
 },
 {
  "id": "L053",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Who would be fading around you right now?",
  "sec": "end",
  "start": 199.409,
  "end": 201.548
 }
]