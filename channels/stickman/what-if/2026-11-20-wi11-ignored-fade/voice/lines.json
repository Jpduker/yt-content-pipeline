[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By Friday, you can see through the barista.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Not a little. You can read the menu through his chest.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He's been making your coffee for two years. You've never asked his name.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And he's not the only one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.5,
  "group": "G002"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "It starts on Monday. The man in the lift is a bit pale. You assume it's the lighting.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Tuesday, Dana is talking to you while you answer an email. Halfway through her sentence, you notice you can see the printer behind her.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G004"
 },
 {
  "id": "L007",
  "tag": "COLL",
  "thought": false,
  "note": "",
  "text": "\u2026so that's my news. What do you think?",
  "voice": "af_nicole",
  "speed": 1.12,
  "gain": 1.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L008",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Great! Yeah. Great.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L009",
  "tag": "COLL",
  "thought": false,
  "note": "",
  "text": "I said my cat died.",
  "voice": "af_nicole",
  "speed": 1.12,
  "gain": 1.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She fades a little more. You watch it happen.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.6,
  "group": "G008"
 },
 {
  "id": "L011",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Dana. Sorry. I wasn't listening. Tell me about your cat.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She tells you. The cat was called Biscuit, and he hated everyone except her. With every sentence, she gets a little more solid.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G010"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So that's the rule. Ignore someone, and they fade. Pay attention, and they come back.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You get good at it. You learn the barista's name: Kofi. You ask the lift man about his dog. You stop typing when your boss talks, which surprises him more than anyone.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G011"
 },
 {
  "id": "L015",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Are you\u2026 listening?",
  "voice": "bm_george",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L016",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Yes.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L017",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Nobody listens. This is very unsettling.",
  "voice": "bm_george",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By Thursday, the city looks solid again. You're exhausted. Paying attention, it turns out, is a full-time job.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Friday night, you get home, drop onto the sofa, and open your phone.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G016"
 },
 {
  "id": "L020",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Did you see the score?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G017"
 },
 {
  "id": "L021",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Mm.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L022",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I said, did you see the\u2014",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You look up.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 1.7000000000000002,
  "group": "G020"
 },
 {
  "id": "L024",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You can see the cushions through your brother.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.6,
  "group": "G021"
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Not a little. Almost all the way.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You checked everyone. The barista, the lift, the boss. You never checked the person on your sofa.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.6,
  "group": "G022"
 },
 {
  "id": "L027",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Theo. What score?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L028",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Doesn't matter.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L029",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It does. Who played?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L030",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You hate football.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L031",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know. Tell me anyway.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He tells you. All of it. The match, the referee, a goal he's still angry about. Then, somehow, his job interview on Monday, which you didn't know about.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G028"
 },
 {
  "id": "L033",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You've got an interview?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L034",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I told you. Twice.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L035",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Tell me a third time. I'm listening now.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G031"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By midnight, he's solid again. Fully, annoyingly solid. He's eaten all your crisps.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G032"
 },
 {
  "id": "L037",
  "tag": "BARISTA",
  "thought": false,
  "note": "",
  "text": "Morning! The usual?",
  "voice": "am_puck",
  "speed": 1.06,
  "gain": 0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G033"
 },
 {
  "id": "L038",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Morning, Kofi. How's your weekend?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G034"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Kofi looks so surprised you think he might drop the cup.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He doesn't fade. Neither does anyone else. Not this week.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L041",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Who would be fading around you right now?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G036"
 }
]