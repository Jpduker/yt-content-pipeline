[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You wake up nervous. Your heart's racing. Your hands are wet.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Which is strange, because you've got nothing to be nervous about.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Four hours away, your best friend has an exam at nine.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "From today, you feel everything she feels.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.6,
  "group": "G002"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Everything. The good, the bad, and the fourth coffee.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L006",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Why are you breathing like that?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G004"
 },
 {
  "id": "L007",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Exam.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L008",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You don't have an exam.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L009",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know!",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At nine, her exam starts, and your mind goes completely blank.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G008"
 },
 {
  "id": "L011",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "So the numbers for March are\u2014",
  "voice": "bm_george",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L012",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm sorry. Who are you?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G010"
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At ten, she has her fourth coffee. You have a meeting.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G011"
 },
 {
  "id": "L014",
  "tag": "BOSS",
  "thought": false,
  "note": "",
  "text": "Are you vibrating?",
  "voice": "bm_george",
  "speed": 1.04,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L015",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Big fan of this quarter.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At twelve, her exam is over and she's happy. So you're happy. You're so happy, you nearly hug Dana.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G014"
 },
 {
  "id": "L017",
  "tag": "COLL",
  "thought": false,
  "note": "",
  "text": "Please don't.",
  "voice": "af_nicole",
  "speed": 1.12,
  "gain": 1.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At one, she eats a pastry. You can't taste it. But you have never loved a sandwich this much.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G016"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At three, she watches a horror film with her new flatmates.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G017"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You don't.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.4,
  "group": "G017"
 },
 {
  "id": "L021",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Sorry! Spreadsheet. Very scary numbers.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.9,
  "group": "G018"
 },
 {
  "id": "L022",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At half five, her bus is late. You glare at a pigeon. The pigeon didn't do anything.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G019"
 },
 {
  "id": "L023",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Sorry.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L024",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You just apologised to a pigeon. It's been a long day, and none of it was yours.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By the evening, results are out tomorrow, and she's worried. So you're worried. And you can't turn it off.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G022"
 },
 {
  "id": "L026",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Why are you pacing?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L027",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm not pacing. I'm walking with purpose.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L028",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Can you feel me as well?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L029",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "No.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L030",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Good.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L031",
  "tag": "YOU",
  "thought": false,
  "note": "text",
  "text": "Did you sleep? Did you eat? Did you check question six?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.9,
  "group": "G028"
 },
 {
  "id": "L032",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "Why are you being my mum?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Because her worry is sitting in your chest, and you want it out.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You tell yourself you're helping. You're not. You just want the feeling to stop.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L035",
  "tag": "YOU",
  "thought": false,
  "note": "text",
  "text": "Just relax. It'll be fine.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G031"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Her worry goes up. You can feel exactly how much.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.4,
  "group": "G032"
 },
 {
  "id": "L037",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "Wow. Thanks. Going to bed.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Now she's annoyed. And then, quietly, something else.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G034"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Something heavy. Like a wet coat you can't take off.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G034"
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At midnight, you're lying in the dark, sad for a reason that isn't yours.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G035"
 },
 {
  "id": "L041",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you call her.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L042",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "I'm fine.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G036"
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She's not. You can feel she's not.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G037"
 },
 {
  "id": "L044",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You want to fix it. Tell her the exam went well. Tell her the course is worth it. Tell her she'll make friends.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L045",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "But once, at a caf\u00e9, you learned not to answer things she hadn't said.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G038"
 },
 {
  "id": "L046",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You don't have to be fine.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G039"
 },
 {
  "id": "L047",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "I just miss home. That's all. It's stupid.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G040"
 },
 {
  "id": "L048",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It's not stupid.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G041"
 },
 {
  "id": "L049",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And then you don't say anything else. You just stay on the line.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G042"
 },
 {
  "id": "L050",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Five minutes. Ten. Neither of you talks.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G043"
 },
 {
  "id": "L051",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And the heavy coat gets lighter. Not gone. Shared.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G043"
 },
 {
  "id": "L052",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You've felt her nervous, happy, terrified and annoyed today. This is the first feeling you didn't try to make go away.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G043"
 },
 {
  "id": "L053",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Are you still there?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.7,
  "group": "G044"
 },
 {
  "id": "L054",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm here.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G045"
 },
 {
  "id": "L055",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "You're smiling. I can hear it.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G046"
 },
 {
  "id": "L056",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Will you stay on until I fall asleep?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G046"
 },
 {
  "id": "L057",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Yeah.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G047"
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "She falls asleep at twenty to one. You can feel it, like a lamp being turned down slowly in another city.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G048"
 },
 {
  "id": "L059",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The next morning, at nine, a feeling hits you so hard you drop your toast.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G049"
 },
 {
  "id": "L060",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "She passed!",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G050"
 },
 {
  "id": "L061",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Who passed what?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G051"
 },
 {
  "id": "L062",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Everything!",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G052"
 },
 {
  "id": "L063",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Did you drop your toast?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G053"
 },
 {
  "id": "L064",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Worth it.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G054"
 },
 {
  "id": "L065",
  "tag": "MIRA",
  "thought": false,
  "note": "text",
  "text": "Passed! Did you feel that?",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G055"
 },
 {
  "id": "L066",
  "tag": "YOU",
  "thought": false,
  "note": "text",
  "text": "Felt it. Dropped my toast.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G056"
 },
 {
  "id": "L067",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Would you want to feel everything they feel?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G057"
 }
]