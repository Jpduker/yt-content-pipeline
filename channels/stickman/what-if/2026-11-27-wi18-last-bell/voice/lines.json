  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Kofi the barista. Ding. He moved to Lisbon.",
