[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Monday, there's a list on your fridge. Five names.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Every friendship you ever let break.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Fix one, and the name turns gold. Don't, and on Sunday at midnight, they're gone.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G001"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Not dead. Just gone. You'll pass them in the street, and neither of you will know why you looked.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G001"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You have seven days.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.5,
  "group": "G002"
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The first four are easy to guess. The fifth one makes you laugh.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G003"
 },
 {
  "id": "L007",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Theo? He lives here. He eats my cereal.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You decide the list is broken. Lists can be broken. You put a magnet over his name and go to work.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Jo. In 2019 he sent you a very long message. You meant to answer it properly. You never did.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G006"
 },
 {
  "id": "L010",
  "tag": "JO",
  "thought": false,
  "note": "",
  "text": "You never answered. Not even a thumbs up.",
  "voice": "am_puck",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L011",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know. It was a long message.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L012",
  "tag": "JO",
  "thought": false,
  "note": "",
  "text": "It was about my dad.",
  "voice": "am_puck",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L013",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I'm sorry. I didn't know.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.6,
  "group": "G010"
 },
 {
  "id": "L014",
  "tag": "JO",
  "thought": false,
  "note": "",
  "text": "You didn't ask.",
  "voice": "am_puck",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G011"
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He's right. You didn't. You were busy, and then you were embarrassed about being busy, and then it was four years.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.6,
  "group": "G012"
 },
 {
  "id": "L016",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "How is he? Your dad.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L017",
  "tag": "JO",
  "thought": false,
  "note": "",
  "text": "Better. Do you actually want to know?",
  "voice": "am_puck",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L018",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I actually want to know.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You ask. He talks for an hour. You don't check your phone once.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G016"
 },
 {
  "id": "L020",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Sam. You still have her jacket from a party in 2017.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.9,
  "group": "G017"
 },
 {
  "id": "L021",
  "tag": "SAM",
  "thought": false,
  "note": "phone",
  "text": "You've had it seven years.",
  "voice": "af_bella",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L022",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It's a really good jacket.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L023",
  "tag": "SAM",
  "thought": false,
  "note": "phone",
  "text": "Bring it to football on Thursday. You're in goal.",
  "voice": "af_bella",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L024",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You let in nine goals. Sam laughs so hard she has to sit down. Gold.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G021"
 },
 {
  "id": "L025",
  "tag": "SAM",
  "thought": false,
  "note": "",
  "text": "Same time next week? You can be worse in a different position.",
  "voice": "af_bella",
  "speed": 1.08,
  "gain": 0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Two names down. Three to go. You start to think this is going to be easy.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Mr. Hale. Your old neighbour. You waved at the van, and you never visited.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G024"
 },
 {
  "id": "L028",
  "tag": "NEIGH",
  "thought": false,
  "note": "",
  "text": "Well, look who it is! Come in, I've got eight kinds of biscuits and nobody to eat them.",
  "voice": "bm_lewis",
  "speed": 1.08,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L029",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You eat all eight kinds. He shows you his tomatoes, one by one. He has named them.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L030",
  "tag": "NEIGH",
  "thought": false,
  "note": "",
  "text": "That one's called Gerald. He's my best one. Don't tell the others.",
  "voice": "bm_lewis",
  "speed": 1.08,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L031",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You stay for dinner. You miss the last train and sleep on his sofa under a blanket that smells of biscuits. Gold.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G028"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Danny. Your best friend when you were fourteen. You moved schools, and you promised to write, and you didn't. Not once.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G029"
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Danny doesn't pick up. Thursday. Friday. Saturday.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L034",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "On Saturday night, he texts back.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G029"
 },
 {
  "id": "L035",
  "tag": "DANNY",
  "thought": false,
  "note": "text",
  "text": "I'm not ready. Maybe one day.",
  "voice": "am_onyx",
  "speed": 1.04,
  "gain": 0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The D stays white. You can't fix someone who doesn't want to be fixed. You can only leave the door open.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.8,
  "group": "G031"
 },
 {
  "id": "L037",
  "tag": "YOU",
  "thought": false,
  "note": "text",
  "text": "Whenever you're ready. I'll answer.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G032"
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Sunday. Six hours left. One name. Theo.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G033"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You've fed him, housed him, said sorry to him. But you realise you've never once asked him a question you didn't already know the answer to.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L040",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Theo. What's that game you play every night?",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G034"
 },
 {
  "id": "L041",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You want to know?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G035"
 },
 {
  "id": "L042",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I want to play.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G036"
 },
 {
  "id": "L043",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You'll be terrible.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L044",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I know.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G038"
 },
 {
  "id": "L045",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You have to be the green one. The green one always dies first.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G039"
 },
 {
  "id": "L046",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That feels personal.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G040"
 },
 {
  "id": "L047",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You're terrible. He teaches you anyway. He's patient. You didn't know he was patient.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G041"
 },
 {
  "id": "L048",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You keep looking at the fridge.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G042"
 },
 {
  "id": "L049",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "No, I don't.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G043"
 },
 {
  "id": "L050",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Is my name on that thing?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G044"
 },
 {
  "id": "L051",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It was. Under a magnet.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G045"
 },
 {
  "id": "L052",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Why?",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G046"
 },
 {
  "id": "L053",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Because I've been your brother your whole life. I don't think I've ever been your friend.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G047"
 },
 {
  "id": "L054",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Okay. Well. Friends don't let friends be the green one. Swap.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.7,
  "group": "G048"
 },
 {
  "id": "L055",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At two minutes to midnight, the last T turns gold.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G049"
 },
 {
  "id": "L056",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Four gold names. One white one.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G050"
 },
 {
  "id": "L057",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You leave the list on the fridge. Just in case Danny calls.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G050"
 },
 {
  "id": "L058",
  "tag": "N",
  "thought": false,
  "note": "soft",
  "text": "Whose name would be on your list?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "end",
  "pause": 2.3,
  "group": "G051"
 }
]