 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Two seconds to midnight. Your phone is about to delete your little brother.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, every midnight, your phone deletes the contact you haven't called the longest.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.6,
  "group": "G002"
 },
 {
