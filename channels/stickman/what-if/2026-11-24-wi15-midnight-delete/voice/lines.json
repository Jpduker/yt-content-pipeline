  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Gone for good. You can't save it again.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G002"
 },
 {
