[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Two seconds to midnight. Your phone is about to delete your little brother.",
  "sec": "hook",
  "start": 1.4,
  "end": 5.65
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, every midnight, your phone deletes the contact you haven't called the longest.",
  "sec": "hook",
  "start": 6.59,
  "end": 11.925
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Gone for good. You can't save it again.",
  "sec": "hook",
  "start": 12.065,
  "end": 14.89
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Texts don't count. Only a call, answered before midnight.",
  "sec": "hook",
  "start": 15.03,
  "end": 18.95
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Last month it took Coach Ray. Then your old friend Sam.",
  "sec": "act1",
  "start": 21.049,
  "end": 24.649
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You didn't even notice.",
  "sec": "act1",
  "start": 24.789,
  "end": 26.264
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Tonight, the name at the top is Theo. Thirty days.",
  "sec": "act1",
  "start": 26.515,
  "end": 29.81
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Which is strange. Theo lives in your flat.",
  "sec": "act1",
  "start": 30.056,
  "end": 33.106
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He's in the next room. Right now.",
  "sec": "act1",
  "start": 33.246,
  "end": 35.363
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You text him a meme. Texts don't count.",
  "sec": "act2",
  "start": 37.263,
  "end": 39.683
 },
 {
  "id": "L011",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You knock. He has his headphones on.",
  "sec": "act2",
  "start": 39.823,
  "end": 42.298
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Twenty-three fifty-eight. There's only one way left.",
  "sec": "act2",
  "start": 42.549,
  "end": 45.659
 },
 {
  "id": "L013",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You have to call your brother. Who is eight steps away.",
  "sec": "act2",
  "start": 45.799,
  "end": 48.724
 },
 {
  "id": "L014",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You press call.",
  "sec": "act2",
  "start": 48.864,
  "end": 49.814
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In the next room, his phone is on silent.",
  "sec": "act2",
  "start": 49.954,
  "end": 52.693
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you bang on the wall.",
  "sec": "act3",
  "start": 54.193,
  "end": 55.71
 },
 {
  "id": "L017",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "What?!",
  "sec": "act3",
  "start": 55.97,
  "end": 56.64
 },
 {
  "id": "L018",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Pick up your phone!",
  "sec": "act3",
  "start": 56.79,
  "end": 57.994
 },
 {
  "id": "L019",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "You're literally right there!",
  "sec": "act3",
  "start": 58.144,
  "end": 59.533
 },
 {
  "id": "L020",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Just pick up!",
  "sec": "act3",
  "start": 59.683,
  "end": 60.648
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He picks up at twenty-three fifty-nine and fifty-one seconds.",
  "sec": "act3",
  "start": 61.048,
  "end": 64.658
 },
 {
  "id": "L022",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "Hello?",
  "sec": "act3",
  "start": 64.918,
  "end": 65.539
 },
 {
  "id": "L023",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Hi. It's me.",
  "sec": "act3",
  "start": 65.689,
  "end": 66.736
 },
 {
  "id": "L024",
  "tag": "THEO",
  "thought": false,
  "note": "phone",
  "text": "I know it's you. Why are we doing this?",
  "sec": "act3",
  "start": 66.886,
  "end": 68.723
 },
 {
  "id": "L025",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Midnight comes. Someone else gets deleted. Not Theo.",
  "sec": "act3",
  "start": 69.523,
  "end": 73.443
 },
 {
  "id": "L026",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You stay on the phone for an hour. Through a wall.",
  "sec": "act3",
  "start": 73.583,
  "end": 76.483
 },
 {
  "id": "L027",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Who haven't you called in a while?",
  "sec": "act3",
  "start": 76.678,
  "end": 78.249
 }
]