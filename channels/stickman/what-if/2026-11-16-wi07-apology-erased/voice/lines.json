  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G027"
 },
 {
  "id": "L032",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Did I do something? You can tell me.",
