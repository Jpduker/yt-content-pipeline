  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G060"
 },
 {
  "id": "L067",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You let her be.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G060"
 },
