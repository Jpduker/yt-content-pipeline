  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G033"
 },
 {
  "id": "L038",
  "tag": "BARISTA",
  "thought": false,
  "note": "",
  "text": "You want your usual? It's on\u2014 Actually. Have you paid me lately?",
