  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.7,
  "group": "G053"
 },
 {
  "id": "L059",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Yeah.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G054"
 },
 {
  "id": "L060",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "I am a bit exhausting, though.",
  "voice": "am_liam",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G055"
 },
