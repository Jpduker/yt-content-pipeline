  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G037"
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The word is right there. Sorry. One word, and she'll never know.",
