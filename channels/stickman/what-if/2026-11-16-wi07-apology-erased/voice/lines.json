  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G052"
 },
 {
  "id": "L058",
  "tag": "THEO",
  "thought": false,
  "note": "",
  "text": "Wow. That's rude.",
