  "speed": 1.1,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G028"
 },
 {
  "id": "L033",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "No. You didn't do anything.",
