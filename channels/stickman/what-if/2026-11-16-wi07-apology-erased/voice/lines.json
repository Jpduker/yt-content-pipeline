  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G046"
 },
 {
  "id": "L051",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It's going to be a very big cake.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G047"
 },
 {
  "id": "L052",
  "tag": "N",
  "thought": false,
