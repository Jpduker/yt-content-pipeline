  "pause": 0.0,
  "group": "G030"
 },
 {
  "id": "L035",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Now you see the smudges everywhere. Over your boss. Over the barista. Small grey clouds where a memory used to be.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G031"
 },
 {
  "id": "L036",
  "tag": "BARISTA",
  "thought": false,
  "note": "",
  "text": "Weird week. I keep feeling annoyed at someone, and I can't remember who.",
  "voice": "am_puck",
  "speed": 1.06,
  "gain": 0,
  "sec": "act2",
  "pause": 0.9,
  "group": "G032"
 },
 {
  "id": "L037",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "That's weird.",
