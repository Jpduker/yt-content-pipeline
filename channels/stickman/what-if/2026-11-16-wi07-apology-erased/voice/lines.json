  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G039"
 },
 {
  "id": "L044",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Mira. I forgot your birthday. Completely. And I'm not going to say the word, because I want you to stay mad at me.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.9,
  "group": "G040"
 },
 {
  "id": "L045",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "That is the weirdest apology I have ever heard.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G041"
 },
 {
  "id": "L046",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "It's not an apology. It's a confession.",
