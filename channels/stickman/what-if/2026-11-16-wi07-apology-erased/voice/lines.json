  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G043"
 },
 {
  "id": "L048",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Okay. I'm a bit less mad.",
  "voice": "af_heart",
  "speed": 1.1,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.6,
  "group": "G044"
 },
 {
  "id": "L049",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "Saturday. Cake. In person.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G045"
 },
 {
  "id": "L050",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "It's four hours on a train.",
