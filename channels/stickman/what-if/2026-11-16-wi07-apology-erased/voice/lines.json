  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G038"
 },
 {
  "id": "L043",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And she'll still go to bed sad, and not know why.",
