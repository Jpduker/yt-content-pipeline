  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G036"
 },
 {
  "id": "L041",
  "tag": "MIRA",
  "thought": false,
  "note": "phone",
  "text": "Hey. So. It's ten p.m.",
