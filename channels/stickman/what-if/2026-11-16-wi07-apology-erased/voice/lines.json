  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G048"
 },
 {
  "id": "L054",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then you go and sit next to Theo.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.9,
  "group": "G049"
 },
 {
  "id": "L055",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "On Wednesday, I said something horrible to you. You don't remember it. I do.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G050"
 },
 {
  "id": "L056",
  "tag": "THEO",
  "thought": false,
  "note": "",
