  "text": "You're a lot exhausting. Stay anyway.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G056"
 },
 {
  "id": "L062",
  "tag": "N",
