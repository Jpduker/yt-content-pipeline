  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So you try everything. Bad jokes.",
