  "start": 0.5,
  "end": 4.83
 },
 {
  "id": "L002",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, an umbrella only opens if someone is waiting for you to get home.",
  "sec": "hook",
  "start": 4.95,
  "end": 9.602
 },
 {
  "id": "L003",
  "tag": "WOMAN",
  "thought": false,
  "note": "",
  "text": "Oh. Sorry, love.",
  "sec": "act1",
  "start": 10.402,
  "end": 11.545
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He shakes it. He bangs it. It stays shut.",
  "sec": "act1",
  "start": 11.945,
  "end": 15.05
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He checks his phone. No messages. He's lived alone since the spring.",
  "sec": "act1",
  "start": 15.62,
  "end": 19.694
 },
 {
  "id": "L006",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "So he walks home. Forty minutes. Soaked to the bone.",
  "sec": "act2",
  "start": 20.594,
  "end": 24.044
 },
 {
  "id": "L007",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He tells himself it doesn't matter. Umbrellas are for tourists.",
  "sec": "act2",
  "start": 24.184,
  "end": 27.872
 },
 {
  "id": "L008",
  "tag": "ELI",
  "thought": false,
  "note": "",
  "text": "What? Who\u2026?",
  "sec": "act2",
  "start": 28.582,
  "end": 30.092
 },
 {
  "id": "L009",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Halfway home, it bursts open on its own.",
  "sec": "act2",
  "start": 30.492,
  "end": 33.251
 },
 {
  "id": "L010",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In his front window, Pepper is waiting.",
