[
 {
  "id": "L001",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At seven in the morning, your dog looks you in the eye and says:",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.9,
  "group": "G001"
 },
 {
  "id": "L002",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "We need to talk about the cat.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "hook",
  "pause": 0.0,
  "group": "G002"
 },
 {
  "id": "L003",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "In this world, every dog gets to talk. Once. For twenty-four hours.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.4,
  "group": "G003"
 },
 {
  "id": "L004",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And Biscuit has been waiting eleven years.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "hook",
  "pause": 0.0,
  "group": "G003"
 },
 {
  "id": "L005",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "First, the complaints.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G004"
 },
 {
  "id": "L006",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "The postman is a criminal. I've told you every single day.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L007",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "And the vacuum. Why do you keep a monster in the cupboard?",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G005"
 },
 {
  "id": "L008",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then breakfast.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G006"
 },
 {
  "id": "L009",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Dry food. Again. Eleven years of dry food.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G007"
 },
 {
  "id": "L010",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "You eat socks!",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G008"
 },
 {
  "id": "L011",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Socks are a treat. There's a difference.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G009"
 },
 {
  "id": "L012",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "By nine, Mum is laughing so hard she's crying.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.3,
  "group": "G010"
 },
 {
  "id": "L013",
  "tag": "MUM",
  "thought": false,
  "note": "",
  "text": "Say something about Dad.",
  "voice": "bf_emma",
  "speed": 1.05,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G011"
 },
 {
  "id": "L014",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "He sneaks me cheese. And he sings in the shower. Badly.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act1",
  "pause": 0.0,
  "group": "G012"
 },
 {
  "id": "L015",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Dad goes very red.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L016",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You take Biscuit to the park. Every dog is talking.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.4,
  "group": "G013"
 },
 {
  "id": "L017",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "A poodle is reviewing the benches. A husky won't stop shouting.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L018",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Biscuit just walks next to you. Slowly.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L019",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Slower than last year.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act1",
  "pause": 0.0,
  "group": "G013"
 },
 {
  "id": "L020",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Can we sit down?",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G014"
 },
 {
  "id": "L021",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You sit. He climbs up next to you. It takes him two tries.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G015"
 },
 {
  "id": "L022",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "I need to tell you some things. While I still can.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G016"
 },
 {
  "id": "L023",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "The jokes stop.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.0,
  "group": "G017"
 },
 {
  "id": "L024",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "When you were seven, you cried under the bed after school. Every day for a month.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L025",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "I lay next to you. That was my job.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G018"
 },
 {
  "id": "L026",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I didn't think you knew.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G019"
 },
 {
  "id": "L027",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "I always know.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L028",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Your dad cries in the car sometimes. Your mum talks to me when nobody calls back.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L029",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "I hold all of it. I don't mind.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G020"
 },
 {
  "id": "L030",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Then he says the thing you weren't ready for.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act2",
  "pause": 0.4,
  "group": "G021"
 },
 {
  "id": "L031",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "My legs hurt now. The vet knows. You don't.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act2",
  "pause": 0.0,
  "group": "G022"
 },
 {
  "id": "L032",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "That evening, the whole family sits on the floor.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.6,
  "group": "G023"
 },
 {
  "id": "L033",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "Nobody watches TV. Nobody checks a phone.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G023"
 },
 {
  "id": "L034",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Mum. Thank you for the blanket by the radiator.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L035",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "Dad. Keep the cheese a secret.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G024"
 },
 {
  "id": "L036",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "And then he looks at you.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G025"
 },
 {
  "id": "L037",
  "tag": "DOG",
  "thought": false,
  "note": "",
  "text": "You were my favourite job.",
  "voice": "bm_fable",
  "speed": 1.0,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G026"
 },
 {
  "id": "L038",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "At midnight, he stops talking.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.4,
  "group": "G027"
 },
 {
  "id": "L039",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "He just thumps his tail. Twice.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L040",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "You know exactly what it means.",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.0,
  "group": "G027"
 },
 {
  "id": "L041",
  "tag": "YOU",
  "thought": false,
  "note": "",
  "text": "I love you too, Biscuit.",
  "voice": "am_michael",
  "speed": 1.09,
  "gain": 0.5,
  "sec": "act3",
  "pause": 0.0,
  "group": "G028"
 },
 {
  "id": "L042",
  "tag": "N",
  "thought": false,
  "note": "",
  "text": "What would your dog say to you?",
  "voice": "am_michael",
  "speed": 1.03,
  "gain": -1.0,
  "sec": "act3",
  "pause": 0.5,
  "group": "G029"
 }
]