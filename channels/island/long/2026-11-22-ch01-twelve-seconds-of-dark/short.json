   "lines": [
    {
     "id": "a1",
     "text": "Every morning for thirty years, Gus has walked the same path to the same tower."
    },
    {
     "id": "a2",
     "text": "He winds the clock. He trims the wick. He writes one line in the log: lamp kept."
    },
    {
     "id": "a3",
     "text": "The island has exactly one rule, older than anyone living on it.",
     "pause": 0.6
    },
    {
     "id": "a4",
     "text": "The lamp never goes out. Not for weather. Not for war. Not for anyone.",
     "pause": 0.4
    }
   ],
   "lead": 0.8,
   "tail": 0.6,
   "mood": "day"
