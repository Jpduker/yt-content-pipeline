[
 {
  "id": "n1",
  "text": "The stranger stood by the lamp, and counted.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n2",
  "text": "Gus could see the hood move.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n3",
  "text": "One. Two. Three.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n4",
  "text": "Nine seconds in, Rollo sneezed.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n5",
  "text": "The hood turned.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n6",
  "text": "Not toward the noise. Toward Gus.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n7",
  "text": "As if the stranger had known, all along, exactly where he was.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n8",
  "text": "Then a splash,",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n9",
  "text": "a ring of green light on the water,",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n10",
  "text": "and nothing.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n11",
  "text": "Rollo, ashamed, ran to the waterline to make up for it.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n12",
  "text": "He came back dragging something on a chain.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n13",
  "text": "A silver locket.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n14",
  "text": "Inside, a tiny painted face Gus had only ever seen in his mother\u2019s photographs.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n15",
  "text": "His own.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "n16",
  "text": "As a baby.",
  "voice": "am_michael",
  "speed": 1.0
 }
]